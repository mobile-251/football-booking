// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

enum UserRole {
  ADMIN
  FIELD_OWNER
  VENUE_MANAGER
  PLAYER
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  fullName    String
  phoneNumber String?
  role        UserRole @default(PLAYER)
  avatarUrl   String?
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  player               Player?
  owner                FieldOwner?
  admin                Admin?
  venueManager         VenueManager?
  venueManagersCreated VenueManager[] @relation("VenueManagerCreatedBy")
  walkInBookingsCreated Booking[]       @relation("BookingCreatedBy")
  notifications        Notification[]
  messages             Message[]

  @@map("users")
}

model Player {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  bookings      Booking[]
  reviews       Review[]
  favorites     Favorite[]
  conversations Conversation[]
  wallet        Wallet?
  checkIns      CheckIn[]
  topUpOrders   TopUpOrder[]
  playerCombos  PlayerCombo[]
  bookingHolds  BookingHold[]
  user          User           @relation(fields: [userId], references: [id])

  @@map("players")
}

model FieldOwner {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  venues        Venue[]
  conversations Conversation[]
  user          User           @relation(fields: [userId], references: [id])

  @@map("field_owners")
}

model Admin {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])

  @@map("admins")
}

// ============================================
// VENUE & FIELD
// ============================================

model Venue {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  address     String
  city        String
  district    String?
  latitude    Float?
  longitude   Float?
  openTime    String? // "06:00"
  closeTime   String? // "23:00"
  images      String[] // URLs to images
  ownerId     Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  phoneNumber String?
  email       String?
  amenities   String[] @default([])
  equipment   Json?
  canteenItems Json?
  policies    Json?

  // Relations
  owner         FieldOwner      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fields        Field[]
  venueManagers VenueManager[]
  venueServices VenueService[]
  comboPackages ComboPackage[]

  @@map("venues")
}

model VenueManager {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  venueId     Int
  createdById Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdBy User  @relation("VenueManagerCreatedBy", fields: [createdById], references: [id])

  @@map("venue_managers")
}

enum FieldType {
  FIELD_5VS5
  FIELD_7VS7
  FIELD_11VS11
}

enum FieldOperationalStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum DayType {
  WEEKDAY
  WEEKEND
}

model Field {
  id                Int                    @id @default(autoincrement())
  name              String
  venueId           Int
  fieldType         FieldType
  isActive          Boolean                @default(true)
  operationalStatus FieldOperationalStatus @default(ACTIVE)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  venue    Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  pricings FieldPricing[]
  bookings Booking[]
  reviews  Review[]

  favorites     Favorite[]
  conversations Conversation[]

  @@map("fields")
}

model FieldPricing {
  id        Int      @id @default(autoincrement())
  fieldId   Int
  dayType   DayType
  startTime String // "05:00"
  endTime   String // "16:00"
  price     Int // 200000
  createdAt DateTime @default(now())

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@map("field_pricings")
}

// ============================================
// BOOKING
// ============================================

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BookingSource {
  MOBILE_APP
  WEB_WALK_IN
}

model Booking {
  id              Int           @id @default(autoincrement())
  bookingCode     String        @unique // Mã đặt sân 8 ký tự (BM + 6 chars)
  customerName    String // Họ tên người đặt
  customerPhone   String // SĐT người đặt
  customerEmail   String?
  fieldId         Int
  playerId        Int?
  source          BookingSource @default(MOBILE_APP)
  createdByUserId Int?
  startTime       DateTime
  endTime         DateTime
  totalPrice      Float
  totalCoin       Decimal?      @db.Decimal(12, 2)
  status          BookingStatus @default(PENDING)
  note            String?
  extrasJson      Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  field         Field              @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  player        Player?            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdBy     User?              @relation("BookingCreatedBy", fields: [createdByUserId], references: [id])
  payment       Payment?
  bookingServices BookingService[]
  comboUsage    BookingComboUsage?

  @@index([fieldId, startTime, endTime]) // Index để kiểm tra trùng lịch nhanh
  @@index([bookingCode]) // Index cho tra cứu mã đặt sân
  @@map("bookings")
}

// ============================================
// PAYMENT
// ============================================

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOMO
  VNPAY
}

model Payment {
  id               Int           @id @default(autoincrement())
  bookingId        Int           @unique
  amount           Float
  method           PaymentMethod @default(CASH)
  status           PaymentStatus @default(PENDING)
  transactionId    String?
  sepayPaymentCode String?       @unique
  sepayQrUrl       String?
  sepayOrderMeta   Json?
  expiresAt        DateTime?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model SepayWebhookEvent {
  id                 Int      @id @default(autoincrement())
  sepayTransactionId Int      @unique
  payload            Json
  processedAt        DateTime @default(now())

  @@map("sepay_webhook_events")
}

// ============================================
// REVIEW
// ============================================

model Review {
  id        Int      @id @default(autoincrement())
  fieldId   Int
  playerId  Int
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  field  Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([fieldId, playerId]) // 1 player chỉ review 1 field 1 lần
  @@map("reviews")
}

// ============================================
// REVENUE REPORT
// ============================================

model RevenueReport {
  id            Int      @id @default(autoincrement())
  venueId       Int?
  fieldId       Int?
  totalRevenue  Float
  totalBookings Int
  reportDate    DateTime
  createdAt     DateTime @default(now())

  @@index([venueId, reportDate])
  @@index([fieldId, reportDate])
  @@map("revenue_reports")
}

// ============================================
// FAVORITES
// ============================================

model Favorite {
  id        Int      @id @default(autoincrement())
  playerId  Int
  fieldId   Int
  createdAt DateTime @default(now())

  // Relations
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  field  Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([playerId, fieldId])
  @@map("favorites")
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  BOOKING_PENDING
  PAYMENT_SUCCESS
  PAYMENT_PENDING
  PROMO
  REVIEW_REQUEST
  SYSTEM
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  data      Json? // Additional data like bookingId, fieldId, etc.
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ============================================
// MESSAGING
// ============================================

model Conversation {
  id            Int       @id @default(autoincrement())
  playerId      Int
  ownerId       Int // FieldOwner id
  fieldId       Int? // Optional: conversation about a specific field
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  player   Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  owner    FieldOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  field    Field?     @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([playerId, ownerId])
  @@map("conversations")
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int // User id
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================================
// COIN WALLET & TOP-UP
// ============================================

enum CoinTransactionType {
  TOP_UP
  TOP_UP_BONUS
  BOOKING_SPEND
  SERVICE_SPEND
  COMBO_PURCHASE
  COMBO_REFUND
  CHECKIN_REWARD
  REFUND
  ADMIN_ADJUST
}

enum TopUpOrderStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  REFUNDED
}

enum TopUpPurpose {
  WALLET_TOPUP
  BOOKING_JIT
  COMBO_JIT
}

model Wallet {
  id          Int      @id @default(autoincrement())
  playerId    Int      @unique
  coinBalance Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt   DateTime @updatedAt

  player       Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  transactions CoinTransaction[]

  @@map("wallets")
}

model CoinTransaction {
  id            Int                 @id @default(autoincrement())
  walletId      Int
  type          CoinTransactionType
  amount        Decimal             @db.Decimal(12, 2)
  balanceAfter  Decimal             @db.Decimal(12, 2)
  referenceType String?
  referenceId   Int?
  description   String?
  createdAt     DateTime            @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("coin_transactions")
}

model TopUpPackage {
  id        Int      @id @default(autoincrement())
  name      String
  priceVnd  Int
  baseCoin  Decimal  @db.Decimal(12, 2)
  bonusCoin Decimal  @default(0) @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders TopUpOrder[]

  @@map("top_up_packages")
}

model TopUpOrder {
  id            Int              @id @default(autoincrement())
  playerId      Int
  packageId     Int?
  paymentCode   String           @unique
  priceVnd      Int
  baseCoin      Decimal          @db.Decimal(12, 2)
  bonusCoin     Decimal          @default(0) @db.Decimal(12, 2)
  expectedCoin  Decimal          @db.Decimal(12, 2)
  purpose       TopUpPurpose     @default(WALLET_TOPUP)
  holdId        Int?
  comboPackageId Int?
  status        TopUpOrderStatus @default(PENDING)
  sepayQrUrl    String?
  sepayMeta     Json?
  expiresAt     DateTime
  paidAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  player  Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  package TopUpPackage? @relation(fields: [packageId], references: [id])
  hold    BookingHold?  @relation(fields: [holdId], references: [id])

  @@index([playerId, status])
  @@map("top_up_orders")
}

model BookingHold {
  id           Int      @id @default(autoincrement())
  fieldId      Int
  playerId     Int
  startTime    DateTime
  endTime      DateTime
  totalCoin    Decimal  @db.Decimal(12, 2)
  payload      Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  player      Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  topUpOrders TopUpOrder[]

  @@index([fieldId, startTime, endTime])
  @@map("booking_holds")
}

// ============================================
// CHECK-IN
// ============================================

model CheckIn {
  id           Int      @id @default(autoincrement())
  playerId     Int
  date         DateTime @db.Date
  streakCount  Int
  coinRewarded Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, date])
  @@map("check_ins")
}

model CheckInRewardConfig {
  id           Int     @id @default(autoincrement())
  streakDay    Int     @unique
  coinReward   Decimal @db.Decimal(12, 2)
  isMilestone  Boolean @default(false)
  label        String?

  @@map("check_in_reward_configs")
}

// ============================================
// VENUE SERVICES
// ============================================

enum VenueServiceCategory {
  REFEREE
  EQUIPMENT
  FOOD_DRINK
  OTHER
}

enum VenueServiceUnit {
  PER_MATCH
  PER_HOUR
  PER_ITEM
}

model VenueService {
  id          Int                  @id @default(autoincrement())
  venueId     Int
  name        String
  description String?
  category    VenueServiceCategory @default(OTHER)
  priceCoin   Decimal              @db.Decimal(12, 2)
  unit        VenueServiceUnit     @default(PER_MATCH)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  venue            Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookingServices  BookingService[]

  @@index([venueId, isActive])
  @@map("venue_services")
}

model BookingService {
  id                 Int     @id @default(autoincrement())
  bookingId          Int
  venueServiceId     Int
  quantity           Int     @default(1)
  priceCoinAtBooking Decimal @db.Decimal(12, 2)
  totalCoin          Decimal @db.Decimal(12, 2)

  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  venueService VenueService @relation(fields: [venueServiceId], references: [id])

  @@map("booking_services")
}

// ============================================
// COMBO MEMBERSHIP
// ============================================

enum PlayerComboStatus {
  ACTIVE
  EXPIRED
  EXHAUSTED
  REFUNDED
}

model ComboPackage {
  id           Int       @id @default(autoincrement())
  venueId      Int
  fieldType    FieldType
  name         String
  description  String?
  matchCount   Int
  priceCoin    Decimal   @db.Decimal(12, 2)
  validityDays Int
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  playerCombos PlayerCombo[]

  @@index([venueId, fieldType, isActive])
  @@map("combo_packages")
}

model PlayerCombo {
  id               Int               @id @default(autoincrement())
  playerId         Int
  comboPackageId   Int
  purchasedAt      DateTime          @default(now())
  expiresAt        DateTime
  matchesTotal     Int
  matchesRemaining Int
  status           PlayerComboStatus @default(ACTIVE)

  player       Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  comboPackage ComboPackage        @relation(fields: [comboPackageId], references: [id])
  usages       BookingComboUsage[]

  @@index([playerId, status])
  @@map("player_combos")
}

model BookingComboUsage {
  id              Int      @id @default(autoincrement())
  bookingId       Int      @unique
  playerComboId   Int
  matchesConsumed Int      @default(1)
  consumedAt      DateTime @default(now())

  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  playerCombo PlayerCombo @relation(fields: [playerComboId], references: [id])

  @@map("booking_combo_usages")
}
