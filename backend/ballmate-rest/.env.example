# ==============================================
# Server Configuration
# ==============================================
NODE_ENV=development
PORT=3001

# ==============================================
# Database Configuration
# ==============================================
# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/ballmate?schema=public"

# ==============================================
# JWT Configuration
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ==============================================
# CORS Configuration
# ==============================================
# SePay walk-in (QR chuyển khoản — KHÔNG dùng MERCHANT_ID)
# Đồng bộ CK: poll User API (bắt buộc SEPAY_USER_API_TOKEN). Webhook không cần thiết.
# MSB / BIDV / OCB / KienlongBank: BẮT BUỘC số VA trên Dashboard, không dùng STK chính.
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_NAME=MSB
SEPAY_PAYMENT_CODE_PREFIX=BM
SEPAY_USER_API_TOKEN=
SEPAY_PAYMENT_TTL_MINUTES=5
# Chỉ bật nếu muốn webhook (ngrok + SEPAY_WEBHOOK_API_KEY + SEPAY_ENABLE_WEBHOOK=true)
# SEPAY_ENABLE_WEBHOOK=false
# SEPAY_WEBHOOK_API_KEY=
# MERCHANT_ID / SECRET = cổng thanh toán SePay (checkout), không liên quan QR walk-in
MERCHANT_ID=
MERCHANT_SECRET_KEY=
