# ==============================================
# Server Configuration
# ==============================================
NODE_ENV=development
PORT=3001

# ==============================================
# Database Configuration
# ==============================================
# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/ballmate?schema=public"

# ==============================================
# JWT Configuration
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ==============================================
# CORS Configuration
# ==============================================
# SePay (walk-in QR + webhook)
# Webhook URL (dev): https://<ngrok-id>.ngrok.io/webhooks/sepay
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_NAME=MSB
SEPAY_PAYMENT_CODE_PREFIX=BM
SEPAY_WEBHOOK_API_KEY=
# Token API tại my.sepay.vn → API (để poll giao dịch khi webhook chưa tới)
SEPAY_USER_API_TOKEN=
SEPAY_PAYMENT_TTL_MINUTES=5
MERCHANT_ID=
MERCHANT_SECRET_KEY=
